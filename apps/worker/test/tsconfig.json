{
  // The Worker's Node-side tests (the D1 repository contract suite): Node types, not the
  // Workers runtime's, so they live outside src/.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "rootDir": "..",
    "outDir": "../dist/test-types",
    "tsBuildInfoFile": "../dist/test-types/.tsbuildinfo",
    "emitDeclarationOnly": true
  },
  "include": [".", "../vitest.config.ts"],
  "references": [{ "path": ".." }, { "path": "../../../packages/server" }]
}
