{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // The program includes the git-ignored generated/ client import map (11 §5).
    "rootDir": "../..",
    "outDir": "dist-types",
    "tsBuildInfoFile": "dist-types/.tsbuildinfo",
    "emitDeclarationOnly": true
  },
  "include": [
    "src",
    "vite-plugin",
    "sw",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "../../generated/client-games.ts"
  ],
  "references": [{ "path": "../../packages/api-client" }, { "path": "../../packages/sdk" }]
}
