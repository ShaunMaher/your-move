# Values for apps/node/docker-compose.tunnel.yml (docs/deploy.md). None of these is a secret: the
# secrets are files in SECRETS_DIR. Copy this file somewhere outside the repository, fill it in and
# pass it with `docker compose --env-file`.

# The image to run, by digest (from the pipeline's publish:image job; never a tag).
APP_IMAGE=registry.example.org/group/project/server@sha256:<digest>
# Where the secret files live: an absolute path to a directory only you can enter (mode 0700).
SECRETS_DIR=/srv/secrets

# TRUST_PROXY_PEERS is set in the compose file to cloudflared's pinned address alone; don't add
# addresses to it.

# The tunnel's public hostname, as an origin: https only, no path.
PUBLIC_URL=https://<hostname>
# Optional: the name shown in the app, its emails and home-screen icon. Default: the project's name.
APP_NAME=
# Shown on the privacy and security pages.
OPERATOR_CONTACT=ops@example.org
# Optional: comma-separated admin addresses.
ADMIN_EMAILS=

# The dedicated sender user (docs/deploy.md, "Email through Gmail"), on your Workspace domain.
# GMAIL_SENDER must be the address in EMAIL_FROM.
EMAIL_FROM='"Example Games" <no-reply@example.org>'
GMAIL_SENDER=no-reply@example.org
