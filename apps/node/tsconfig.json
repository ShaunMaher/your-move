{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // The program includes the git-ignored generated/ registry, which only apps import (11 §5).
    "rootDir": "../..",
    "outDir": "dist/types",
    "tsBuildInfoFile": "dist/types/.tsbuildinfo",
    "emitDeclarationOnly": true
  },
  "include": [
    "src",
    "scripts",
    "../../generated/server-registry.ts",
    "../../generated/installed.json"
  ],
  "references": [{ "path": "../../packages/server" }, { "path": "../../packages/sdk" }]
}
