{
  "name": "@your-move/node",
  "version": "0.0.0",
  "private": true,
  "description": "The Node runtime: HTTP server and static files (Docker target)",
  "license": "BSD-2-Clause",
  "type": "module",
  "exports": {
    ".": "./src/server.ts"
  },
  "scripts": {
    "dev": "pnpm --filter @your-move/web build && node --disallow-code-generation-from-strings --env-file=../../config/local-dev.env --import tsx src/main.ts --static ../web/dist",
    "build": "tsx scripts/build.ts",
    "start": "node --disallow-code-generation-from-strings dist/main.js"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@your-move/server": "workspace:*",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@your-move/web": "workspace:*",
    "esbuild": "catalog:",
    "fast-check": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
