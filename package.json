{
  "name": "@your-move/root",
  "version": "0.0.0",
  "private": true,
  "description": "Asynchronous turn-based games with friends: monorepo root",
  "license": "BSD-2-Clause",
  "type": "module",
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "prepare": "tsx scripts/src/bin/hooks-install.ts && pnpm games:generate",
    "dev:node": "pnpm games:generate && pnpm --filter @your-move/node dev",
    "dev:worker": "pnpm games:generate && pnpm --filter @your-move/worker dev",
    "build": "pnpm games:check-inputs --reset && pnpm games:generate && pnpm games:verify --fast && pnpm --recursive --filter=!@your-move/root build && pnpm games:check-inputs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm games:generate && eslint . --max-warnings 0",
    "lint:arch": "pnpm games:generate && depcruise --config .dependency-cruiser.mjs apps packages games scripts tests generated",
    "lint:unused": "pnpm games:generate && knip --treat-config-hints-as-errors",
    "lint:licences": "tsx scripts/src/bin/licences-check.ts",
    "lint:vulns": "tsx scripts/src/bin/vulns-check.ts",
    "lint:pins": "tsx scripts/src/bin/pins-check.ts",
    "typecheck": "pnpm games:generate && tsc --build",
    "test": "pnpm games:generate && vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @your-move/e2e test",
    "games:generate": "tsx scripts/src/bin/games-generate.ts",
    "games:verify": "tsx scripts/src/bin/games-verify.ts",
    "games:check-inputs": "tsx scripts/src/bin/games-check-inputs.ts",
    "games:check-db": "tsx scripts/src/bin/games-check-db.ts",
    "api:generate": "tsx scripts/src/bin/api-generate.ts",
    "renovate:sync": "tsx scripts/src/bin/renovate-sync.ts",
    "gates:prove": "tsx scripts/src/bin/gates-prove.ts",
    "sbom:app": "pnpm --filter . --filter @your-move/web --filter @your-move/node sbom --prod --sbom-format cyclonedx --sbom-type application --out sbom/node.cdx.json && pnpm --filter . --filter @your-move/web --filter @your-move/worker sbom --prod --sbom-format cyclonedx --sbom-type application --out sbom/worker.cdx.json",
    "api:surface": "pnpm --filter @your-move/sdk run api:surface",
    "changeset": "changeset"
  },
  "dependencies": {
    "@your-move/game-example": "workspace:*",
    "@your-move/game-words": "workspace:*",
    "@your-move/sdk": "workspace:*"
  },
  "devDependencies": {
    "@changesets/changelog-git": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint-community/eslint-plugin-eslint-comments": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@your-move/scripts": "workspace:*",
    "@your-move/testkit": "workspace:*",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
