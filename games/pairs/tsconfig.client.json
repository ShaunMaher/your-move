{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/client/.tsbuildinfo",
    // The DOM types for the client and its component tests; it imports the engine's built types.
    "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "include": ["src/client"],
  "references": [{ "path": "../../packages/sdk" }, { "path": "./tsconfig.engine.json" }]
}
