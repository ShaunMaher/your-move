{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The client and its component tests need the DOM types; engines are kept off the DOM by the
    // engine lint config and the dependency rules (02 §7.5), not by the compiler.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src"],
  "references": [{ "path": "../../packages/sdk" }, { "path": "../../packages/testkit" }]
}
