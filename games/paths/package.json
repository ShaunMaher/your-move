{
  "name": "@your-move/game-paths",
  "version": "0.0.0",
  "private": true,
  "description": "Path-laying tile game for 2 to 8 players",
  "license": "BSD-2-Clause",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/test-support.*",
    "!dist/client/dom-setup.*",
    "!dist/**/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "peerDependencies": {
    "@your-move/sdk": "workspace:^",
    "react": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@your-move/sdk": "workspace:*",
    "@your-move/testkit": "workspace:*",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
