{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    // Node types for the tests (kit-words.test.ts reads and writes its generated file). No DOM
    // library, so `window`, `document` and the other DOM globals are type errors in the engine.
    // The Node types do declare `crypto`, `fetch`, `process` and `localStorage`-like globals, so
    // those are NOT caught here: the engine lint's allow-list and the architecture rules (11 §5)
    // are what keep them out of `src/engine`.
    "types": ["node"],
    "lib": ["ES2023"]
  },
  "include": ["src"],
  "exclude": ["src/client"],
  "references": [
    { "path": "../../packages/sdk" },
    { "path": "../../packages/testkit" },
    // Tests only, never the engine: the board-size cap is tied to the dictionaries' word-length
    // cap (words §9.1), and the property tests build the real word list (test-support.ts).
    { "path": "../../packages/dictionary/tsconfig.runtime.json" },
    { "path": "../../packages/dictionary/tsconfig.build.json" }
  ]
}
