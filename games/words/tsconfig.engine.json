{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    // Node types for the tests (kit-words.test.ts reads and writes its generated file). No DOM
    // library: the engine and everything beside it compile without `window`, `document` or
    // `crypto` typings, so a DOM use in the engine is a type error, not just a lint finding.
    "types": ["node"],
    "lib": ["ES2023"]
  },
  "include": ["src"],
  "exclude": ["src/client"],
  "references": [
    { "path": "../../packages/sdk" },
    { "path": "../../packages/testkit" },
    // Tests only, never the engine: the board-size cap is tied to the dictionaries' word-length
    // cap (words §9.1), and the property tests build the real word list (test-support.ts).
    { "path": "../../packages/dictionary/tsconfig.runtime.json" },
    { "path": "../../packages/dictionary/tsconfig.build.json" }
  ]
}
