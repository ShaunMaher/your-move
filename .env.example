# Every configuration variable (docs/spec/09-operations.md §1). Node reads the environment;
# Cloudflare reads vars and secrets (`wrangler secret put NAME`). Empty values count as unset.
# On Node, any secret may instead be given as a file: NAME_FILE=/run/secrets/name (wins over NAME;
# one trailing newline is trimmed; setting both is allowed only if they are equal).
# For local development nothing is needed: `pnpm dev:node` uses config/local-dev.env.

# --- Identity ----------------------------------------------------------------------------------
# Display name everywhere (UI, emails, manifest). Default: the project's name.
APP_NAME=
# Home-screen label (12 characters or fewer recommended). Default: APP_NAME.
APP_SHORT_NAME=
# Required. Canonical origin: https, no path. http is allowed only for http://localhost,
# http://127.0.0.1 or http://[::1] (local-dev mode).
PUBLIC_URL=https://play.example.org
# Required, secret. Base64 of at least 32 random bytes: `openssl rand -base64 32`.
# Never rotate it without reading docs/spec/09-operations.md §1.1.
APP_SECRET=
# Required. Shown on the privacy and security pages.
OPERATOR_CONTACT=ops@example.org
# Minimum age confirmed at onboarding; a whole number of at least 13. Default 13.
MIN_AGE=

# --- Email -------------------------------------------------------------------------------------
# Required: gmail, smtp (Node only), resend, postmark, ses, cloudflare (Workers only) or
# console (local-dev mode only).
EMAIL_PROVIDER=smtp
# Required: an address or "Name" <address>.
EMAIL_FROM="Games" <no-reply@example.org>
# The most messages the provider accepts in any 24 hours. Default 2000 for gmail, unset otherwise
# (set it for smtp through Google's relay, which shares the Workspace user's quota). When known,
# startup refuses instance-wide email caps that could send more: W = 2 × (LIMIT_OTP_EMAIL_GLOBAL_DAY
# + LIMIT_INVITE_EMAILS_GLOBAL_DAY + LIMIT_NUDGE_EMAILS_PER_DAY), 1500 with the defaults (08 §4.2).
# A Workspace trial (500 a day) needs EMAIL_DAILY_QUOTA=500 AND lower caps, e.g. 150, 50 and 50
# (W = 2 × 250 = 500).
EMAIL_DAILY_QUOTA=
# Secret; required for resend, postmark and ses.
EMAIL_API_KEY=
# Secret; required for smtp: smtp://user:pass@host:587 (STARTTLS) or smtps://user:pass@host:465.
SMTP_URL=
# Secrets; required for gmail (09 §2): the Internal OAuth client and the gmail.send refresh token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Required for gmail: the sender user's own address; must equal EMAIL_FROM's address.
GMAIL_SENDER=

# --- Web Push (all three, or none) -------------------------------------------------------------
# Secrets, from `pnpm gen:vapid --out <dir>` (unpadded base64url; on Docker give them as
# VAPID_PUBLIC_KEY_FILE and VAPID_PRIVATE_KEY_FILE). Without all three, no pushes are sent.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https:// URL.
VAPID_SUBJECT=

# --- Turnstile (both, or neither) --------------------------------------------------------------
TURNSTILE_SITE_KEY=
# Secret.
TURNSTILE_SECRET=
# Cloudflare builds only: set to true at build time so the static CSP allows Turnstile.
TURNSTILE_ENABLED=

# --- Games and dictionaries --------------------------------------------------------------------
# Comma-separated installed game types offered for new games. Default: every installed package
# not marked enabled: false in instance.config.ts.
ENABLED_GAMES=
# Comma-separated built-in dictionary ids offered for new games. Default: all bundled.
DICTIONARIES_ENABLED=
# true or false: whether players may upload word lists. Default true.
DICTIONARY_UPLOADS=
# Comma-separated operator dictionary ids, each added through the Admin API.
DICTIONARIES_EXTRA=
# Module config: each game receives only its own keys, prefix stripped (e.g. GAMES_WORDS_*).
# GAMES_WORDS_ENABLED_RULESETS=
# GAMES_WORDS_DEFAULT_RULESET=classic
# GAMES_WORDS_DEFAULT_DICTIONARY=enable

# --- Administration and limits -----------------------------------------------------------------
# Comma-separated addresses of admins; empty disables the Admin API.
ADMIN_EMAILS=
# Rate-limit and cap overrides (08 §4), positive whole numbers; empty keeps the default shown.
LIMIT_DICT_TOTAL_BYTES=
# Sign-in (06 §3): per address, per client IP (×4 and ×10 for wider IPv6 buckets), instance-wide.
LIMIT_OTP_REQUEST_EMAIL_HOUR=
LIMIT_OTP_REQUEST_EMAIL_DAY=
LIMIT_OTP_REQUEST_IP_HOUR=
LIMIT_OTP_VERIFY_FAIL_EMAIL_HOUR=
LIMIT_OTP_VERIFY_IP_HOUR=
LIMIT_OTP_EMAIL_GLOBAL_HOUR=
LIMIT_OTP_EMAIL_GLOBAL_DAY=
LIMIT_OTP_VERIFY_FAIL_GLOBAL_HOUR=
LIMIT_NEW_ACCOUNTS_IP_DAY=
LIMIT_DISPLAY_NAME_CHANGES_30D=
LIMIT_STEP_UP_USER_HOUR=
LIMIT_STEP_UP_USER_DAY=
# Games (08 §4): every game write, moves and previews per user per minute; games created per user
# and per invitee per day; typed email invitees per user; invitations received per target, per
# creator and in total (the inbound cap).
LIMIT_WRITES_USER_MINUTE=
LIMIT_MOVES_USER_MINUTE=
LIMIT_PREVIEWS_USER_MINUTE=
LIMIT_GAMES_CREATED_USER_DAY=
LIMIT_GAMES_CREATED_PAIR_DAY=
LIMIT_EMAIL_INVITEES_USER_HOUR=
LIMIT_EMAIL_INVITEES_USER_DAY=
LIMIT_INVITATIONS_RECEIVED_PAIR_DAY=
LIMIT_INVITATIONS_RECEIVED_DAY=
# Invite emails to addresses without an account (06 §6.6): per inviter a day and per 30 days, a
# day for an account under 7 days old that hasn't finished a game, per address per 30 days, and
# instance-wide a day.
LIMIT_INVITE_EMAILS_INVITER_DAY=
LIMIT_INVITE_EMAILS_INVITER_30D=
LIMIT_INVITE_EMAILS_NEW_INVITER_DAY=
LIMIT_INVITE_EMAILS_TARGET_30D=
LIMIT_INVITE_EMAILS_GLOBAL_DAY=
# "It's your turn" email nudges (03 §7): instance-wide and per recipient a day.
LIMIT_NUDGE_EMAILS_PER_DAY=
LIMIT_NUDGE_EMAILS_PER_USER_PER_DAY=
# debug, info, warn or error. Default info.
LOG_LEVEL=

# --- Node only ---------------------------------------------------------------------------------
# Default 8080.
PORT=
# Default /data/app.sqlite.
DATABASE_PATH=
# Default /data/blobs.
BLOB_DIR=
# Where client IPs come from (08 §4.1): false (socket), xff (X-Forwarded-For) or cloudflare.
TRUST_PROXY=
# With xff: the number of trusted proxies in front of the app. Default 1.
TRUST_PROXY_HOPS=
# With xff or cloudflare: CIDR list the socket peer must be in. Default: private ranges and
# loopback (the compose files pin their network's subnet instead).
TRUST_PROXY_PEERS=
# true for ONE start to accept orphaning live games of removed game types or rules versions.
ALLOW_ORPHAN_GAMES=
