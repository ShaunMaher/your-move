# Local development only (docs/spec/06-auth.md §4): `pnpm dev:node` and `pnpm dev:worker` load
# this file so a fresh clone runs with no setup. Every value here is public. The server accepts
# this APP_SECRET and the console email provider only when PUBLIC_URL is http://localhost, so
# none of it can be used by a real deployment. Copy .env.example for anything else.
PUBLIC_URL=http://localhost:8080
APP_SECRET=bG9jYWwtZGV2LW9ubHktbm90LWEtc2VjcmV0LWRvLW5vdC11c2U=
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@localhost
OPERATOR_CONTACT=ops@localhost
LOG_LEVEL=debug
# pnpm dev:node sets DATABASE_PATH to <repository root>/data/dev.sqlite (git-ignored), an absolute
# path, so the database never depends on where the process started.
