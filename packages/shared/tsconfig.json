{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Web-standard APIs only (03 §1): the WebWorker library has fetch, URL and WebCrypto, no DOM.
    "lib": ["ES2023", "WebWorker"],
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "emitDeclarationOnly": true
  },
  "include": ["src"],
  "references": [{ "path": "../sdk" }]
}
